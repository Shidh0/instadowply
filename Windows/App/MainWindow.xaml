<Window x:Class="InstaDowplyWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instadowply" Height="820" Width="460"
        WindowStartupLocation="CenterScreen" 
        Icon="app.ico"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown" MouseWheel="Window_MouseWheel">

    <Window.Background>
        <!-- Instagram Dark Mode Subtle Gradient -->
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0D0D11" Offset="0.0"/>
            <GradientStop Color="#1A0B1A" Offset="0.5"/>
            <GradientStop Color="#08080C" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <!-- Clean Glass Button Style for Sidebar Actions -->
        <Style x:Key="CleanButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Sleek Seek Bar Style -->
        <Style x:Key="ModernSliderStyle" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="3" Background="#FFFF007F" CornerRadius="1.5"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="3" Background="#3DFFFFFF" CornerRadius="1.5"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Ellipse Width="10" Height="10" Fill="White"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!-- Video Media Player Layer -->
        <MediaElement x:Name="VideoPlayer" 
                      LoadedBehavior="Manual" 
                      UnloadedBehavior="Stop"
                      MediaEnded="VideoPlayer_MediaEnded"
                      MouseLeftButtonDown="VideoPlayer_MouseLeftButtonDown"
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Stretch" 
                      Stretch="Uniform">
            <MediaElement.RenderTransform>
                <TranslateTransform x:Name="VideoTransform"/>
            </MediaElement.RenderTransform>
        </MediaElement>

        <!-- Double Tap Heart Overlay -->
        <Image x:Name="HeartOverlay" Width="100" Height="100" Visibility="Collapsed" 
               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <Image.Source>
                <DrawingImage>
                    <DrawingImage.Drawing>
                        <GeometryDrawing Brush="#E5FFFFFF">
                            <GeometryDrawing.Geometry>
                                <PathGeometry Figures="M12,21.35L10.55,20.03C5.4,15.36 2,12.28 2,8.5C2,5.42 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.09C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.42 22,8.5C22,12.28 18.6,15.36 13.45,20.04L12,21.35Z"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingImage.Drawing>
                </DrawingImage>
            </Image.Source>
        </Image>

        <!-- TOP BAR OVERLAY -->
        <Grid VerticalAlignment="Top" Margin="16,12,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <ProgressBar x:Name="FeedProgressBar" Grid.Row="0" Height="2.5" Foreground="#E1306C" Background="#26FFFFFF" BorderThickness="0"/>

            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Button Style="{StaticResource CleanButtonStyle}" Click="Info_Click" Width="36" Height="36" HorizontalAlignment="Left">
                    <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17M11,9H13V7H11V9Z" Fill="White" Stretch="Uniform" Width="20" Height="20"/>
                </Button>
                
                <TextBlock x:Name="TxtCounter" Text="0 / 0" Foreground="#B3FFFFFF" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                
                <Button Style="{StaticResource CleanButtonStyle}" Click="Refresh_Click" Width="36" Height="36" HorizontalAlignment="Right">
                    <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z" Fill="White" Stretch="Uniform" Width="20" Height="20"/>
                </Button>
            </Grid>
        </Grid>

        <!-- RIGHT SIDEBAR ACTION BUTTONS -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,120">
            <StackPanel Margin="0,0,0,14" HorizontalAlignment="Center">
                <Button x:Name="BtnLike" Style="{StaticResource CleanButtonStyle}" Width="44" Height="44" Click="BtnLike_Click">
                    <Path x:Name="HeartIconPath" Data="M12,21.35L10.55,20.03C5.4,15.36 2,12.28 2,8.5C2,5.42 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.09C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.42 22,8.5C22,12.28 18.6,15.36 13.45,20.04L12,21.35Z" 
                          Stroke="White" StrokeThickness="2" Fill="Transparent" Stretch="Uniform" Width="26" Height="26"/>
                </Button>
                <TextBlock x:Name="TxtLikeCount" Text="" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            </StackPanel>

            <Button x:Name="BtnSave" Style="{StaticResource CleanButtonStyle}" Width="44" Height="44" Click="BtnSave_Click" Margin="0,0,0,14">
                <Path x:Name="SaveIconPath" Data="M5,3H19V21L12,15L5,21V3Z" 
                      Stroke="White" StrokeThickness="2" Fill="Transparent" Stretch="Uniform" Width="24" Height="24"/>
            </Button>

            <Button Style="{StaticResource CleanButtonStyle}" Width="44" Height="44" Click="BtnOpenWeb_Click" Margin="0,0,0,14">
                <Path Data="M7,2H17C19.76,2 22,4.24 22,7V17C22,19.76 19.76,22 17,22H7C4.24,22 2,19.76 2,17V7C2,4.24 4.24,2 7,2ZM12,7C9.24,7 7,9.24 7,12C7,14.76 9.24,17 12,17C14.76,17 17,14.76 17,12C17,9.24 14.76,7 12,7Z" 
                      Stroke="White" StrokeThickness="2" Stretch="Uniform" Width="24" Height="24"/>
            </Button>

            <Button Style="{StaticResource CleanButtonStyle}" Width="44" Height="44" Click="BtnShare_Click" Margin="0,0,0,14">
                <Path Data="M22,2L11,13M22,2L15,22L11,13L2,9L22,2Z" 
                      Stroke="White" StrokeThickness="2" Stretch="Uniform" Width="22" Height="22"/>
            </Button>

            <!-- MATCHED ENGINE PLAY BUTTON -->
            <Button x:Name="BtnStartEngine" Style="{StaticResource CleanButtonStyle}" Width="44" Height="44" Click="BtnStartEngine_Click" ToolTip="Start Engine">
                <Path Data="M8,5.14V18.86C8,19.63 8.84,20.11 9.51,19.73L21.51,12.87C22.17,12.49 22.17,11.51 21.51,11.13L9.51,4.27C8.84,3.89 8,4.37 8,5.14Z" 
                      Stroke="White" StrokeThickness="2" Fill="Transparent" Stretch="Uniform" Width="22" Height="22"/>
            </Button>
        </StackPanel>

        <!-- BOTTOM CAPTION & PROFILE OVERLAY -->
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,0,0,45" Width="280">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6" Cursor="Hand" MouseDown="Profile_MouseDown">
                <Ellipse x:Name="ImgPfp" Width="34" Height="34" Fill="#333333"/>
                <TextBlock x:Name="TxtUsername" Text="@user" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBlock x:Name="TxtVerified" Text="★" Foreground="#3897F0" FontSize="14" VerticalAlignment="Center" Margin="4,0,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <TextBlock x:Name="TxtCaption" Text="" Foreground="White" FontSize="13" TextWrapping="Wrap" 
                       MaxHeight="36" LineHeight="18" LineStackingStrategy="BlockLineHeight"
                       TextTrimming="CharacterEllipsis" Cursor="Hand" MouseDown="Caption_MouseDown"/>
            
            <TextBlock x:Name="TxtViews" Text="" Foreground="#E6FFFFFF" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- BOTTOM AUDIO BADGE -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,45" Width="72">
            <Border Width="38" Height="38" CornerRadius="6" Background="#333333" HorizontalAlignment="Center">
                <Image x:Name="ImgAudioArt" Stretch="UniformToFill"/>
            </Border>
            <TextBlock x:Name="TxtAudioTrack" Text="" Foreground="White" FontSize="10" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="28" TextAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- BOTTOM ISOLATED SEEKBAR -->
        <Slider x:Name="VideoScrubber" Style="{StaticResource ModernSliderStyle}" 
                VerticalAlignment="Bottom" Margin="16,0,16,14" 
                Height="16" Minimum="0" Maximum="1" 
                PreviewMouseLeftButtonDown="VideoScrubber_PreviewMouseLeftButtonDown" 
                PreviewMouseLeftButtonUp="VideoScrubber_PreviewMouseLeftButtonUp" 
                ValueChanged="VideoScrubber_ValueChanged"/>
    </Grid>
</Window>